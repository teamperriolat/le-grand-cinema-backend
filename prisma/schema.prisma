generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  USED
}

enum TicketStatus {
  PENDING_PAYMENT
  ACTIVE
  USED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUSED
  REFUNDED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  role         Role          @default(USER)
  reservations Reservation[]
  createdAt    DateTime      @default(now())
}

model Movie {
  id          String      @id @default(cuid())
  title       String
  description String
  durationMin Int
  posterUrl   String?
  screenings  Screening[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Screening {
  id            String        @id @default(cuid())
  movieId       String
  movie         Movie         @relation(fields: [movieId], references: [id], onDelete: Cascade)
  startsAt      DateTime
  roomId        String
  room          Room          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  priceCents    Int
  expectedRatio Float         @default(0.6)
  seats         Seat[]
  reservations  Reservation[]
  createdAt     DateTime      @default(now())
}

model Room {
  id         String      @id @default(cuid())
  name       String      @unique
  capacity   Int
  screenings Screening[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Seat {
  id               String            @id @default(cuid())
  screeningId      String
  screening        Screening         @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  label            String
  reservationSeats ReservationSeat[]

  @@unique([screeningId, label])
}

model Reservation {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  screeningId String
  screening   Screening         @relation(fields: [screeningId], references: [id])
  totalCents  Int
  status      ReservationStatus @default(CONFIRMED)
  seats       ReservationSeat[]
  ticket      Ticket?
  payment     Payment?
  createdAt   DateTime          @default(now())
}

model Ticket {
  id            String       @id @default(cuid())
  code          String       @unique @default(cuid())
  reservationId String       @unique
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  status        TicketStatus @default(PENDING_PAYMENT)
  createdAt     DateTime     @default(now())
  validatedAt   DateTime?
}

model Payment {
  id            String        @id @default(cuid())
  reservationId String        @unique
  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  amountCents   Int
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ReservationSeat {
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  seatId        String      @unique
  seat          Seat        @relation(fields: [seatId], references: [id], onDelete: Restrict)

  @@id([reservationId, seatId])
}
